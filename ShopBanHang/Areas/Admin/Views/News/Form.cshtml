@model News

<div class="adm-panel adm-form-panel adm-form-wide">
    <div class="adm-panel-head">
        <h2>@(Model.Id == 0 ? "Thêm bài viết" : "Sửa bài viết")</h2>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <form asp-action="Save" method="post" enctype="multipart/form-data" class="p-3">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger small"></span>
            <div class="form-text">Đường dẫn sinh tự động từ tiêu đề.</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Ảnh bài viết</label>
            <input type="file" name="anhTaiLen" class="form-control" accept="image/*" />
            <div class="form-text">Tối đa 4 MB. Để trống khi sửa thì giữ ảnh cũ.</div>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mt-2">
                    <img src="@Model.ImageUrl" alt="@Model.Title"
                         style="max-height:120px;border-radius:6px" />
                </div>
            }
        </div>

        <div class="mb-3">
            <label asp-for="Summary" class="form-label"></label>
            <textarea asp-for="Summary" class="form-control" rows="2"
                      placeholder="Vài dòng giới thiệu, hiện ở danh sách tin"></textarea>
            <span asp-validation-for="Summary" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control" rows="10"></textarea>
            <span asp-validation-for="Content" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu</button>
            <a asp-action="Index" class="btn btn-light">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
