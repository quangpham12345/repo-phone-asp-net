@model AdminOrderDetailViewModel
@using ShopBanHang.Helpers
@{
    var don = Model.Don;

    // Chữ trên nút cho từng bước, để admin đọc là hiểu việc mình sắp làm
    string NhanNut(OrderStatus tt) => tt switch
    {
        OrderStatus.DaXacNhan => "Xác nhận đơn",
        OrderStatus.DangGiao => "Giao cho vận chuyển",
        OrderStatus.HoanThanh => "Đã giao thành công",
        _ => tt.Nhan()
    };
    string IconNut(OrderStatus tt) => tt switch
    {
        OrderStatus.DaXacNhan => "bi-check2-circle",
        OrderStatus.DangGiao => "bi-truck",
        OrderStatus.HoanThanh => "bi-box-seam",
        _ => "bi-arrow-right"
    };

    var cacBuocTien = Model.BuocTiepTheo.Where(b => b.TrangThai != OrderStatus.DaHuy).ToList();
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Danh sách đơn
    </a>
</div>

<div class="row g-3">
    @* ===== Thông tin đơn ===== *@
    <div class="col-lg-6">
    <div class="adm-panel h-100">
        <div class="adm-panel-head">
            <h2>Thông tin đơn</h2>
            <span class="st @TrangThaiDon.LopAdmin(don.Status)">@don.Status.Nhan()</span>
        </div>

        <div class="p-3">
            <dl class="adm-dl mb-0">
                <dt>Mã đơn</dt>
                <dd><code class="adm-ma-don">@don.OrderCode</code></dd>

                <dt>Người nhận</dt>
                <dd>@don.CustomerName</dd>

                <dt>Điện thoại</dt>
                <dd>@don.Phone</dd>

                <dt>Email</dt>
                <dd>@(string.IsNullOrEmpty(don.Email) ? "—" : don.Email)</dd>

                <dt>Địa chỉ giao</dt>
                <dd>@don.Address</dd>

                <dt>Ngày đặt</dt>
                <dd>@don.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt>Tài khoản</dt>
                <dd>
                    @if (don.User != null)
                    {
                        @don.User.Email
                    }
                    else
                    {
                        <span class="text-muted">khách không đăng nhập</span>
                    }
                </dd>

                @if (!string.IsNullOrEmpty(don.Note))
                {
                    <dt>Ghi chú</dt>
                    <dd>@don.Note</dd>
                }

                @if (don.Status == OrderStatus.DaHuy)
                {
                    <dt>Ngày huỷ</dt>
                    <dd>@(don.CancelledAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
                    <dt>Lý do huỷ</dt>
                    <dd>@(string.IsNullOrEmpty(don.CancelReason) ? "—" : don.CancelReason)</dd>
                }
            </dl>
        </div>
    </div>
    </div>

    <div class="col-lg-6">
        @* ===== Thanh toán ===== *@
        <div class="adm-panel mb-3">
            <div class="adm-panel-head">
                <h2>Thanh toán</h2>
                @if (don.IsPaid)
                {
                    <span class="st st-done">Đã thanh toán</span>
                }
                else if (don.Status == OrderStatus.DaHuy)
                {
                    <span class="st st-todo">Đơn đã huỷ</span>
                }
                else
                {
                    <span class="st st-wait">Chưa thanh toán</span>
                }
            </div>
            <div class="p-3">
                <dl class="adm-dl mb-0">
                    <dt>Hình thức</dt>
                    <dd>@don.PaymentMethod.Nhan()</dd>

                    @if (don.PaidAt.HasValue)
                    {
                        <dt>Thời điểm</dt>
                        <dd>@don.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                    }
                    @if (don.PaymentMethod == PaymentMethod.ChuyenKhoan)
                    {
                        <dt>Nội dung CK</dt>
                        <dd><code>@don.OrderCode.Replace("-", "")</code></dd>
                    }
                </dl>

                @if (Model.CanXacNhanThanhToan)
                {
                    <form asp-action="MarkPaid" asp-route-id="@don.Id" method="post" class="mt-3"
                          onsubmit="return confirm('Xác nhận đã nhận đủ @TienViet.Dinh(don.Total) cho đơn @don.OrderCode?');">
                        <button type="submit" class="btn btn-sm btn-success">
                            <i class="bi bi-cash-stack"></i> Xác nhận đã thanh toán
                        </button>
                    </form>
                    <p class="text-muted small mt-2 mb-0">
                        Kiểm tra sao kê ngân hàng có khoản <b>@TienViet.Dinh(don.Total)</b> với nội dung
                        <code>@don.OrderCode.Replace("-", "")</code> rồi mới bấm.
                    </p>
                }
                else if (don.PaymentMethod == PaymentMethod.COD && !don.IsPaid && don.Status != OrderStatus.DaHuy)
                {
                    <p class="text-muted small mt-3 mb-0">
                        Đơn COD tự được đánh dấu đã thanh toán khi chuyển sang <b>Hoàn thành</b>.
                    </p>
                }
                @if (don.Status == OrderStatus.DaHuy && don.IsPaid)
                {
                    <div class="alert alert-warning small mt-3 mb-0">
                        Đơn đã thanh toán nhưng bị huỷ: cần hoàn tiền cho khách.
                    </div>
                }
            </div>
        </div>

        @* ===== Xử lý đơn ===== *@
        <div class="adm-panel">
            <div class="adm-panel-head">
                <h2>Xử lý đơn</h2>
            </div>

            <div class="p-3">
                @if (Model.BuocTiepTheo.Count == 0)
                {
                    <div class="alert alert-light border mb-0">
                        Đơn đã ở trạng thái cuối (<b>@don.Status.Nhan()</b>), không chuyển tiếp được nữa.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var (tt, lyDoKhong) in cacBuocTien)
                        {
                            <form asp-action="ChangeStatus" asp-route-id="@don.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('@NhanNut(tt) cho đơn @don.OrderCode?');">
                                <input type="hidden" name="moi" value="@((int)tt)" />
                                <button type="submit" class="btn btn-sm btn-primary"
                                        disabled="@(lyDoKhong != null)" title="@lyDoKhong">
                                    <i class="bi @IconNut(tt)"></i> @NhanNut(tt)
                                </button>
                            </form>
                        }
                    </div>

                    @foreach (var (_, lyDoKhong) in cacBuocTien.Where(b => b.LyDoKhong != null))
                    {
                        <p class="small text-warning mt-2 mb-0"><i class="bi bi-info-circle"></i> @lyDoKhong</p>
                    }

                    @if (Model.CoTheHuy)
                    {
                        <hr />
                        <form asp-action="ChangeStatus" asp-route-id="@don.Id" method="post"
                              onsubmit="return confirm('Huỷ đơn @don.OrderCode? Tồn kho sẽ được hoàn lại.');">
                            <input type="hidden" name="moi" value="@((int)OrderStatus.DaHuy)" />
                            <label class="form-label small mb-1" for="lyDoHuy">Lý do huỷ</label>
                            <div class="input-group input-group-sm">
                                <input type="text" name="lyDoHuy" id="lyDoHuy" maxlength="250" class="form-control"
                                       placeholder="Ví dụ: khách không nghe máy, hết hàng..." />
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-x-circle"></i> Huỷ đơn
                                </button>
                            </div>
                        </form>
                    }

                    <p class="text-muted small mt-3 mb-0">
                        Luồng một chiều: Chờ xác nhận → Đã xác nhận → Đang giao → Hoàn thành.
                        Huỷ được ở ba bước đầu; huỷ thì tồn kho của từng phân loại được cộng trả lại
                        và mã giảm giá (nếu có) được trả lượt. Sang <b>Hoàn thành</b> thì cộng số đã bán.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@* ===== Các dòng hàng ===== *@
<div class="adm-panel mt-3">
    <div class="adm-panel-head">
        <h2>Sản phẩm trong đơn</h2>
        <span class="adm-badge">@don.OrderDetails.Count dòng</span>
    </div>

    <div class="table-responsive">
        <table class="table adm-table mb-0">
            <thead>
                <tr>
                    <th style="width:70px">Ảnh</th>
                    <th>Sản phẩm</th>
                    <th style="width:140px" class="text-end">Đơn giá</th>
                    <th style="width:90px" class="text-end">Số lượng</th>
                    <th style="width:150px" class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dong in don.OrderDetails)
                {
                    <tr>
                        <td>
                            <img src="@PhanLoai.Anh(dong.ProductVariant?.ImageUrl, dong.Product?.ImageUrl)"
                                 alt="@dong.ProductName"
                                 style="width:44px;height:44px;object-fit:cover;border-radius:4px" />
                        </td>
                        <td>
                            @(dong.ProductName ?? dong.Product?.Name)
                            @if (!string.IsNullOrEmpty(dong.VariantName))
                            {
                                <div class="small text-muted">@dong.VariantName</div>
                            }
                        </td>
                        <td class="text-end adm-tien">@TienViet.Dinh(dong.UnitPrice)</td>
                        <td class="text-end">@dong.Quantity</td>
                        <td class="text-end adm-tien">@TienViet.Dinh(dong.LineTotal)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end">Tiền hàng</td>
                    <td class="text-end adm-tien">@TienViet.Dinh(don.Subtotal)</td>
                </tr>
                @if (don.DiscountAmount > 0)
                {
                    <tr>
                        <td colspan="4" class="text-end">
                            Giảm giá @if (!string.IsNullOrEmpty(don.CouponCode)) { <code>@don.CouponCode</code> }
                        </td>
                        <td class="text-end adm-tien text-success">-@TienViet.Dinh(don.DiscountAmount)</td>
                    </tr>
                }
                <tr>
                    <td colspan="4" class="text-end"><b>Tổng thanh toán</b></td>
                    <td class="text-end adm-tong-tien"><b>@TienViet.Dinh(don.Total)</b></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<p class="text-muted small mt-3 mb-0">
    Đơn giá, tên sản phẩm và phân loại ở đây là <b>giá trị tại thời điểm khách mua</b>, lưu trong bảng OrderDetails.
    Shop đổi giá hay đổi tên sản phẩm sau này cũng không làm sai hoá đơn cũ.
</p>
