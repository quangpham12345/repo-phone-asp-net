@model PagedResult<Order>
@using ShopBanHang.Helpers

<div class="adm-panel">
    <div class="adm-panel-head">
        <h2>Đơn hàng</h2>
        <span class="adm-badge">@Model.TotalItems đơn</span>
    </div>

    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 p-3 border-bottom">
        <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control"
               style="max-width:280px" placeholder="Mã đơn, tên người nhận hoặc số điện thoại" />

        <select name="trangThai" class="form-select" style="max-width:180px">
            <option value="">— Mọi trạng thái —</option>
            @foreach (OrderStatus tt in Enum.GetValues<OrderStatus>())
            {
                <option value="@((int)tt)" selected="@(ViewBag.TrangThai as OrderStatus? == tt)">
                    @tt.Nhan()
                </option>
            }
        </select>

        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Tìm</button>
        <a asp-action="Index" class="btn btn-light">Bỏ lọc</a>
    </form>

    <div class="table-responsive">
        <table class="table adm-table mb-0">
            <thead>
                <tr>
                    <th style="width:52px">STT</th>
                    <th style="width:160px">Mã đơn</th>
                    <th>Người nhận</th>
                    <th style="width:120px">Điện thoại</th>
                    <th style="width:140px" class="text-end">Tổng tiền</th>
                    <th style="width:130px">Thanh toán</th>
                    <th style="width:140px">Trạng thái</th>
                    <th style="width:130px">Ngày đặt</th>
                    <th style="width:80px" class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Không có đơn nào khớp điều kiện</td></tr>
                }

                @{ int stt = Model.SttDau; }
                @foreach (var don in Model.Items)
                {
                    stt++;
                    <tr>
                        <td class="text-center">@stt</td>
                        <td><code class="adm-ma-don">@don.OrderCode</code></td>
                        <td>
                            <b>@don.CustomerName</b>
                            @if (don.UserId == null)
                            {
                                <span class="adm-badge ms-1">khách lẻ</span>
                            }
                        </td>
                        <td>@don.Phone</td>
                        <td class="text-end adm-tien">@TienViet.Dinh(don.Total)</td>
                        <td class="small">@don.PaymentMethod.Nhan()</td>
                        <td>
                            @{
                                string lopTrangThai = don.Status switch
                                {
                                    OrderStatus.HoanThanh => "st-done",
                                    OrderStatus.DaHuy => "st-todo",
                                    _ => "st-wait"
                                };
                            }
                            <span class="st @lopTrangThai">@don.Status.Nhan()</span>
                        </td>
                        <td class="small">@don.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Detail" asp-route-id="@don.Id"
                               class="btn btn-sm btn-outline-secondary" title="Xem chi tiết">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="p-3 border-top">
            <ul class="pagination mb-0">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-trangThai="@((int?)(ViewBag.TrangThai as OrderStatus?))">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<p class="text-muted small mt-3 mb-0">
    Đơn hàng <b>không xoá được</b>, chỉ chuyển trạng thái — đó là lịch sử bán hàng.
    Bấm vào biểu tượng con mắt để xem chi tiết và đổi trạng thái.
</p>
