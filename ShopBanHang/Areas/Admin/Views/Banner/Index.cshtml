@model List<Banner>

<div class="adm-panel">
    <div class="adm-panel-head">
        <h2>Banner trang chủ</h2>
        <div class="d-flex align-items-center gap-2">
            <span class="adm-badge">@Model.Count banner</span>
            <a asp-action="Create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i> Thêm banner
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table adm-table mb-0">
            <thead>
                <tr>
                    <th style="width:62px">Thứ tự</th>
                    <th style="width:180px">Ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Liên kết</th>
                    <th style="width:110px">Trạng thái</th>
                    <th style="width:150px" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có banner nào</td></tr>
                }

                @foreach (var bn in Model)
                {
                    <tr class="@(bn.IsActive ? "" : "adm-dong-an")">
                        <td class="text-center"><b>@bn.SortOrder</b></td>
                        <td>
                            <img src="@bn.ImageUrl" alt="@bn.Title" class="adm-banner-thumb"
                                 style="width:160px;height:52px;object-fit:cover;border-radius:4px" />
                        </td>
                        <td>@bn.Title</td>
                        <td class="small text-muted">
                            @if (string.IsNullOrEmpty(bn.LinkUrl))
                            {
                                <span>— không bấm được —</span>
                            }
                            else
                            {
                                <code>@bn.LinkUrl</code>
                            }
                        </td>
                        <td>
                            @if (bn.IsActive)
                            {
                                <span class="text-success"><i class="bi bi-check-circle"></i> Đang hiện</span>
                            }
                            else
                            {
                                <span class="text-muted"><i class="bi bi-slash-circle"></i> Đã ẩn</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <form asp-action="ToggleActive" asp-route-id="@bn.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(bn.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                        title="@(bn.IsActive ? "Ẩn banner" : "Hiện banner")">
                                    <i class="bi @(bn.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@bn.Id"
                               class="btn btn-sm btn-outline-secondary" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@bn.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Xoa banner nay?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xoá">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<p class="text-muted small mt-3 mb-0">
    Số thứ tự nhỏ hiện trước trên trang chủ. Banner đã ẩn vẫn còn trong danh sách này
    nhưng không xuất hiện ở slideshow.
</p>
