@model Banner

<div class="adm-panel adm-form-panel adm-form-wide">
    <div class="adm-panel-head">
        <h2>@(Model.Id == 0 ? "Thêm banner" : "Sửa banner")</h2>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    @* enctype bắt buộc có, thiếu là file tải lên luôn null *@
    <form asp-action="Save" method="post" enctype="multipart/form-data" class="p-3">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" placeholder="Điện thoại chính hãng, bảo hành 12 tháng" />
            <span asp-validation-for="Title" class="text-danger small"></span>
            <div class="form-text">Tiêu đề cũng là chữ mô tả ảnh, hiện ra khi ảnh lỗi.</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Ảnh tải lên từ máy</label>
            <input type="file" name="anhTaiLen" class="form-control" accept="image/*" />
            <div class="form-text">
                Tối đa 4 MB, nhận jpg, jpeg, png, webp, gif, svg.
                Chọn ảnh ở đây thì đường dẫn bên dưới sẽ bị ghi đè.
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label"></label>
            <input asp-for="ImageUrl" class="form-control" placeholder="/images/banners/banner-phu-kien.svg" />
            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            <div class="form-text">Hoặc gõ thẳng đường dẫn ảnh có sẵn.</div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="adm-banner-preview mt-2">
                    <img src="@Model.ImageUrl" alt="@Model.Title"
                         style="max-width:100%;max-height:160px;border-radius:6px" />
                </div>
            }
        </div>

        <div class="mb-3">
            <label asp-for="LinkUrl" class="form-label"></label>
            <input asp-for="LinkUrl" class="form-control" placeholder="/Product?danhMuc=dien-thoai" />
            <span asp-validation-for="LinkUrl" class="text-danger small"></span>
            <div class="form-text">Để trống thì banner chỉ để xem, không bấm được.</div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="SortOrder" class="form-label"></label>
                <input asp-for="SortOrder" type="number" class="form-control" min="0" max="999" />
                <span asp-validation-for="SortOrder" class="text-danger small"></span>
                <div class="form-text">Số nhỏ hiện trước</div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label d-block">Trạng thái</label>
                <div class="form-check mt-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu</button>
            <a asp-action="Index" class="btn btn-light">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
