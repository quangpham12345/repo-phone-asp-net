@*
    Menu bên trái khu quản trị.
    Mục đang mở lấy từ ViewData["ActiveMenu"] do controller đặt.
    Chỉ liệt kê mục đã làm xong, thêm dần theo từng giai đoạn.
*@
@{
    string active = ViewData["ActiveMenu"] as string ?? "";
}
<aside class="adm-sidebar">

    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="adm-brand">
        <i class="bi bi-buildings-fill"></i>
        <span>ShopBanHang<small>Quản trị</small></span>
    </a>

    <nav class="adm-nav">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="@(active == "dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i> Tổng quan
        </a>

        <div class="adm-nav-label">Bán hàng</div>

        <a asp-area="Admin" asp-controller="Order" asp-action="Index"
           class="@(active == "don-hang" ? "active" : "")">
            <i class="bi bi-receipt"></i> Đơn hàng
        </a>

        <a asp-area="Admin" asp-controller="Coupon" asp-action="Index"
           class="@(active == "ma-giam-gia" ? "active" : "")">
            <i class="bi bi-ticket-perforated"></i> Mã giảm giá
        </a>

        <div class="adm-nav-label">Danh mục sản phẩm</div>

        <a asp-area="Admin" asp-controller="Product" asp-action="Index"
           class="@(active == "san-pham" ? "active" : "")">
            <i class="bi bi-box-seam"></i> Sản phẩm
            @await Component.InvokeAsync("TonKhoThap")
        </a>
        <a asp-area="Admin" asp-controller="Category" asp-action="Index"
           class="@(active == "danh-muc" ? "active" : "")">
            <i class="bi bi-diagram-3"></i> Danh mục
        </a>
        <a asp-area="Admin" asp-controller="Brand" asp-action="Index"
           class="@(active == "thuong-hieu" ? "active" : "")">
            <i class="bi bi-award"></i> Thương hiệu
        </a>

        <div class="adm-nav-label">Nội dung</div>

        <a asp-area="Admin" asp-controller="News" asp-action="Index"
           class="@(active == "tin-tuc" ? "active" : "")">
            <i class="bi bi-newspaper"></i> Tin tức
        </a>
        <a asp-area="Admin" asp-controller="Banner" asp-action="Index"
           class="@(active == "banner" ? "active" : "")">
            <i class="bi bi-images"></i> Banner trang chủ
        </a>

        <div class="adm-nav-label">Hệ thống</div>

        <a asp-area="Admin" asp-controller="User" asp-action="Index"
           class="@(active == "tai-khoan" ? "active" : "")">
            <i class="bi bi-people"></i> Tài khoản
        </a>
    </nav>

    <a asp-area="" asp-controller="Home" asp-action="Index" class="adm-backsite">
        <i class="bi bi-box-arrow-left"></i> Về trang bán hàng
    </a>
</aside>
