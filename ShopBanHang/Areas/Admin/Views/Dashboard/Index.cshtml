@model DashboardViewModel
@using ShopBanHang.Helpers

<div class="adm-cards">
    <div class="adm-card">
        <div class="adm-card-icon bg-orange"><i class="bi bi-cash-coin"></i></div>
        <div>
            <div class="adm-card-num">@TienViet.Dinh(Model.DoanhThuThangNay)</div>
            <div class="adm-card-label">Doanh thu tháng này</div>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-card-icon bg-blue"><i class="bi bi-receipt"></i></div>
        <div>
            <div class="adm-card-num">@Model.SoDon</div>
            <div class="adm-card-label">Đơn hàng</div>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-card-icon bg-purple"><i class="bi bi-box-seam"></i></div>
        <div>
            <div class="adm-card-num">@Model.SoSanPham</div>
            <div class="adm-card-label">Sản phẩm</div>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-card-icon bg-green"><i class="bi bi-people"></i></div>
        <div>
            <div class="adm-card-num">@Model.SoKhachHang</div>
            <div class="adm-card-label">Khách hàng</div>
        </div>
    </div>
</div>

@* ===== Đơn theo trạng thái ===== *@
<div class="adm-panel mt-3">
    <div class="adm-panel-head">
        <h2>Đơn hàng theo trạng thái</h2>
        <a asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-secondary">
            Xem tất cả đơn
        </a>
    </div>
    <div class="p-3 d-flex flex-wrap gap-2">
        <a asp-controller="Order" asp-action="Index" asp-route-trangThai="0"
           class="adm-chip text-decoration-none">Chờ xác nhận <b>@Model.DonChoXacNhan</b></a>
        <a asp-controller="Order" asp-action="Index" asp-route-trangThai="1"
           class="adm-chip text-decoration-none">Đã xác nhận <b>@Model.DonDaXacNhan</b></a>
        <a asp-controller="Order" asp-action="Index" asp-route-trangThai="2"
           class="adm-chip text-decoration-none">Đang giao <b>@Model.DonDangGiao</b></a>
        <a asp-controller="Order" asp-action="Index" asp-route-trangThai="3"
           class="adm-chip text-decoration-none">Hoàn thành <b>@Model.DonHoanThanh</b></a>
        <a asp-controller="Order" asp-action="Index" asp-route-trangThai="4"
           class="adm-chip text-decoration-none">Đã huỷ <b>@Model.DonDaHuy</b></a>
    </div>
</div>

@* ===== Cảnh báo tồn kho ===== *@
<div class="adm-panel mt-3">
    <div class="adm-panel-head">
        <h2>Cảnh báo tồn kho</h2>
        <span class="adm-badge">@Model.CanhBaoTonKho.Count mục · ngưỡng ≤ @NguongTonKho.Nguong</span>
    </div>
    <div class="table-responsive">
        <table class="table adm-table mb-0">
            <thead>
                <tr>
                    <th style="width:52px">Ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Biến thể</th>
                    <th style="width:90px" class="text-end">Tồn kho</th>
                    <th style="width:110px">Mức</th>
                    <th style="width:90px" class="text-end">Xử lý</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.CanhBaoTonKho.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Tồn kho đều ổn, chưa có mục nào cần nhập thêm</td></tr>
                }
                @foreach (var c in Model.CanhBaoTonKho.Take(10))
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrEmpty(c.Anh) ? "/images/products/no-image.svg" : c.Anh)"
                                 alt="@c.TenSanPham" style="width:36px;height:36px;object-fit:cover;border-radius:4px" />
                        </td>
                        <td><b>@c.TenSanPham</b></td>
                        <td>@(c.BienThe ?? "—")</td>
                        <td class="text-end"><b>@c.Ton</b></td>
                        <td>
                            @if (c.DaHet)
                            {
                                <span class="st" style="background:#fde8e8;color:#c0392b">Hết hàng</span>
                            }
                            else
                            {
                                <span class="st st-wait">Sắp hết</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (c.BienThe != null)
                            {
                                <a asp-controller="ProductVariant" asp-action="Index" asp-route-productId="@c.SanPhamId"
                                   class="btn btn-sm btn-outline-primary" title="Nhập thêm hàng"><i class="bi bi-layers"></i></a>
                            }
                            else
                            {
                                <a asp-controller="Product" asp-action="Edit" asp-route-id="@c.SanPhamId"
                                   class="btn btn-sm btn-outline-secondary" title="Sửa tồn kho"><i class="bi bi-pencil"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.CanhBaoTonKho.Count > 10)
    {
        <p class="text-muted small p-3 mb-0 border-top">Và @(Model.CanhBaoTonKho.Count - 10) mục khác nữa.</p>
    }
</div>


@* ===== Hai biểu đồ vẽ bằng Chart.js ===== *@
<div class="adm-panel mt-3">
    <div class="adm-panel-head">
        <h2>Doanh thu 30 ngày gần nhất</h2>
        <span class="adm-badge">chỉ tính đơn đã hoàn thành</span>
    </div>
    <div class="p-3">
        <canvas id="bieuDoNgay" height="90"></canvas>
    </div>
</div>

<div class="adm-panel mt-3">
    <div class="adm-panel-head">
        <h2>Doanh thu 12 tháng gần nhất</h2>
        <span class="adm-badge">cao nhất @TienViet.Dinh(Model.DoanhThuCaoNhat)</span>
    </div>
    <div class="p-3">
        <canvas id="bieuDoThang" height="90"></canvas>
    </div>
</div>

<div class="adm-hai-cot mt-3">
    @* ===== Sản phẩm bán chạy ===== *@
    <div class="adm-panel">
        <div class="adm-panel-head">
            <h2>Sản phẩm bán chạy</h2>
        </div>
        <div class="table-responsive">
            <table class="table adm-table mb-0">
                <thead>
                    <tr>
                        <th style="width:52px">Ảnh</th>
                        <th>Sản phẩm</th>
                        <th style="width:80px" class="text-end">Đã bán</th>
                        <th style="width:130px" class="text-end">Doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.TopSanPham.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Chưa có đơn hoàn thành nào</td></tr>
                    }
                    @foreach (var sp in Model.TopSanPham)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(sp.Anh) ? "/images/products/no-image.svg" : sp.Anh)"
                                     alt="@sp.Ten" style="width:36px;height:36px;object-fit:cover;border-radius:4px" />
                            </td>
                            <td>@sp.Ten</td>
                            <td class="text-end"><b>@sp.SoLuongBan</b></td>
                            <td class="text-end adm-tien">@TienViet.Dinh(sp.DoanhThu)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ===== Khách mua nhiều nhất ===== *@
    <div class="adm-panel">
        <div class="adm-panel-head">
            <h2>Khách mua nhiều nhất</h2>
        </div>
        <div class="table-responsive">
            <table class="table adm-table mb-0">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th style="width:120px">Điện thoại</th>
                        <th style="width:70px" class="text-end">Số đơn</th>
                        <th style="width:130px" class="text-end">Tổng tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.TopKhachHang.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Chưa có đơn hoàn thành nào</td></tr>
                    }
                    @foreach (var kh in Model.TopKhachHang)
                    {
                        <tr>
                            <td><b>@kh.Ten</b></td>
                            <td>@kh.DienThoai</td>
                            <td class="text-end">@kh.SoDon</td>
                            <td class="text-end adm-tien">@TienViet.Dinh(kh.TongTien)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<p class="text-muted small mt-3 mb-0">
    Khách mua nhiều nhất gom theo <b>số điện thoại</b> chứ không theo tài khoản,
    vì khách không đăng nhập vẫn đặt được hàng.
</p>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        // Số liệu do Razor đổ thẳng xuống dạng JSON, không cần gọi thêm API
        var nhanNgay = @Html.Raw(Json.Serialize(Model.DoanhThu30Ngay.Select(x => x.Nhan)));
        var tienNgay = @Html.Raw(Json.Serialize(Model.DoanhThu30Ngay.Select(x => x.DoanhThu)));
        var donNgay  = @Html.Raw(Json.Serialize(Model.DoanhThu30Ngay.Select(x => x.SoDon)));

        var nhanThang = @Html.Raw(Json.Serialize(Model.DoanhThu12Thang.Select(x => x.Nhan)));
        var tienThang = @Html.Raw(Json.Serialize(Model.DoanhThu12Thang.Select(x => x.DoanhThu)));
        var donThang  = @Html.Raw(Json.Serialize(Model.DoanhThu12Thang.Select(x => x.SoDon)));

        // Định dạng tiền kiểu Việt cho nhãn trục và chú thích
        function dinhTien(v) {
            return new Intl.NumberFormat('vi-VN').format(v) + ' đ';
        }

        function chuThich(ctx, soDon) {
            return dinhTien(ctx.parsed.y) + ' · ' + soDon[ctx.dataIndex] + ' đơn';
        }

        new Chart(document.getElementById('bieuDoNgay'), {
            type: 'line',
            data: {
                labels: nhanNgay,
                datasets: [{
                    label: 'Doanh thu',
                    data: tienNgay,
                    borderColor: '#c69a39',
                    backgroundColor: 'rgba(198,154,57,.15)',
                    fill: true,
                    tension: .3,
                    pointRadius: 2
                }]
            },
            options: {
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: function (c) { return chuThich(c, donNgay); } } }
                },
                scales: { y: { beginAtZero: true, ticks: { callback: dinhTien } } }
            }
        });

        new Chart(document.getElementById('bieuDoThang'), {
            type: 'bar',
            data: {
                labels: nhanThang,
                datasets: [{
                    label: 'Doanh thu',
                    data: tienThang,
                    backgroundColor: '#c69a39',
                    borderRadius: 4
                }]
            },
            options: {
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: function (c) { return chuThich(c, donThang); } } }
                },
                scales: { y: { beginAtZero: true, ticks: { callback: dinhTien } } }
            }
        });
    </script>
}
