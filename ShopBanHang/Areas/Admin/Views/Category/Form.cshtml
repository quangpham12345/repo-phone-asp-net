@model Category

<div class="adm-panel adm-form-panel">
    <div class="adm-panel-head">
        <h2>@(Model.Id == 0 ? "Thêm danh mục" : "Sửa danh mục")</h2>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <form asp-action="Save" method="post" class="p-3">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Điện thoại" />
            <span asp-validation-for="Name" class="text-danger small"></span>
            <div class="form-text">
                Đường dẫn sinh tự động từ tên, ví dụ "Điện thoại" thành
                <code>dien-thoai</code>. Không phải nhập tay.
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" type="number" class="form-control" min="0" max="999" />
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                <div class="form-text">Số nhỏ hiện trước</div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label d-block">Trạng thái</label>
                <div class="form-check mt-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu</button>
            <a asp-action="Index" class="btn btn-light">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
