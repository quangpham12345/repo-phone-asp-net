@model Brand

<div class="adm-panel adm-form-panel">
    <div class="adm-panel-head">
        <h2>@(Model.Id == 0 ? "Thêm thương hiệu" : "Sửa thương hiệu")</h2>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <form asp-action="Save" method="post" enctype="multipart/form-data" class="p-3">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Apple" />
            <span asp-validation-for="Name" class="text-danger small"></span>
            <div class="form-text">Đường dẫn sinh tự động từ tên.</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Logo tải lên từ máy</label>
            <input type="file" name="anhTaiLen" class="form-control" accept="image/*" />
            <div class="form-text">Tối đa 4 MB. Chọn ảnh ở đây sẽ ghi đè đường dẫn bên dưới.</div>
        </div>

        <div class="mb-3">
            <label asp-for="LogoUrl" class="form-label"></label>
            <input asp-for="LogoUrl" class="form-control" placeholder="để trống nếu không có logo" />
            <span asp-validation-for="LogoUrl" class="text-danger small"></span>

            @if (!string.IsNullOrEmpty(Model.LogoUrl))
            {
                <div class="mt-2">
                    <img src="@Model.LogoUrl" alt="@Model.Name"
                         style="max-height:80px;border-radius:4px" />
                </div>
            }
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu</button>
            <a asp-action="Index" class="btn btn-light">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
