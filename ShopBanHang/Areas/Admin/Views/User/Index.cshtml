@model UserListViewModel

<div class="adm-panel">
    <div class="adm-panel-head">
        <h2>Danh sách tài khoản</h2>
        <div class="d-flex align-items-center gap-2">
            <span class="adm-badge">@Model.KetQua.TotalItems tài khoản</span>
            <a asp-action="Create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i> Thêm tài khoản
            </a>
        </div>
    </div>

    @* ===== Bộ lọc: tìm theo tên/email, lọc theo vai trò và trạng thái ===== *@
    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 p-3 border-bottom">
        <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
               style="max-width:260px" placeholder="Tìm theo họ tên hoặc email" />

        <select name="roleId" class="form-select" style="max-width:180px">
            <option value="">— Mọi vai trò —</option>
            @foreach (var vt in Model.CacVaiTro)
            {
                <option value="@vt.Id" selected="@(Model.RoleId == vt.Id)">@vt.Name</option>
            }
        </select>

        <select name="isActive" class="form-select" style="max-width:180px">
            <option value="">— Mọi trạng thái —</option>
            <option value="true" selected="@(Model.IsActive == true)">Đang hoạt động</option>
            <option value="false" selected="@(Model.IsActive == false)">Đã tắt</option>
        </select>

        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Tìm</button>
        <a asp-action="Index" class="btn btn-light">Bỏ lọc</a>
    </form>

    <div class="table-responsive">
        <table class="table adm-table mb-0">
            <thead>
                <tr>
                    <th style="width:52px">STT</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th style="width:130px">Điện thoại</th>
                    <th style="width:110px">Vai trò</th>
                    <th style="width:120px">Trạng thái</th>
                    <th style="width:120px">Ngày tạo</th>
                    <th style="width:120px" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.KetQua.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            Không có tài khoản nào khớp điều kiện lọc
                        </td>
                    </tr>
                }

                @{ int stt = Model.KetQua.SttDau; }
                @foreach (var u in Model.KetQua.Items)
                {
                    stt++;
                    <tr class="@(u.IsActive ? "" : "adm-dong-an")">
                        <td class="text-center">@stt</td>
                        <td><b>@u.FullName</b></td>
                        <td>@u.Email</td>
                        <td>@u.PhoneNumber</td>
                        <td>
                            @{ string tenVai = Model.TenVaiTro(u.Id); }
                            <span class="st @(tenVai == Role.Admin ? "st-done" : "st-wait")">@tenVai</span>
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="text-success"><i class="bi bi-check-circle"></i> Hoạt động</span>
                            }
                            else
                            {
                                <span class="text-muted"><i class="bi bi-slash-circle"></i> Đã tắt</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            @* Bật/tắt chứ không xoá: bảng Orders đang trỏ tới Users *@
                            <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                        title="@(u.IsActive ? "Tắt tài khoản" : "Bật tài khoản")">
                                    <i class="bi @(u.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@u.Id"
                               class="btn btn-sm btn-outline-secondary" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ===== Phân trang: giữ lại điều kiện lọc trên từng link, nếu không sang trang 2 là mất lọc ===== *@
    @if (Model.KetQua.TotalPages > 1)
    {
        <nav class="p-3 border-top">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.KetQua.CoTrangTruoc ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.KetQua.Page - 1)"
                       asp-route-tuKhoa="@Model.TuKhoa"
                       asp-route-roleId="@Model.RoleId"
                       asp-route-isActive="@Model.IsActive">&laquo;</a>
                </li>

                @for (int i = 1; i <= Model.KetQua.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.KetQua.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-tuKhoa="@Model.TuKhoa"
                           asp-route-roleId="@Model.RoleId"
                           asp-route-isActive="@Model.IsActive">@i</a>
                    </li>
                }

                <li class="page-item @(Model.KetQua.CoTrangSau ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.KetQua.Page + 1)"
                       asp-route-tuKhoa="@Model.TuKhoa"
                       asp-route-roleId="@Model.RoleId"
                       asp-route-isActive="@Model.IsActive">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>

<p class="text-muted small mt-3 mb-0">
    Tài khoản chỉ được bật hoặc tắt, không xoá hẳn — bảng đơn hàng đang trỏ tới tài khoản,
    xoá cứng sẽ làm vỡ lịch sử mua hàng.
</p>
