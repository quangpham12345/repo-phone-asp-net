@model CouponFormViewModel
@{
    // Mã đã có người dùng thì không đổi chữ mã, để đơn cũ còn đối chiếu được
    bool khoaMa = !Model.LaThemMoi && Model.UsedCount > 0;
}

<div class="adm-panel adm-form-panel adm-form-wide">
    <div class="adm-panel-head">
        <h2>@(Model.LaThemMoi ? "Thêm mã giảm giá" : "Sửa mã giảm giá")</h2>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <form asp-action="Save" method="post" class="p-3">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UsedCount" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" style="text-transform:uppercase"
                       readonly="@khoaMa" placeholder="VD: GIAM10" />
                <span asp-validation-for="Code" class="text-danger small"></span>
                @if (khoaMa)
                {
                    <div class="form-text">Mã đã được dùng @Model.UsedCount lượt nên không đổi được chữ mã.</div>
                }
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="DiscountType" class="form-label"></label>
                <select asp-for="DiscountType" id="kieuGiam" class="form-select"
                        asp-items="Html.GetEnumSelectList<DiscountType>()"></select>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="DiscountValue" class="form-label" id="nhanGiaTri"></label>
                <input asp-for="DiscountValue" type="number" min="1" step="1" class="form-control" />
                <span asp-validation-for="DiscountValue" class="text-danger small"></span>
            </div>

            <div class="col-md-4 mb-3" id="khungTran">
                <label asp-for="MaxDiscount" class="form-label"></label>
                <input asp-for="MaxDiscount" type="number" min="1" step="1" class="form-control" />
                <span asp-validation-for="MaxDiscount" class="text-danger small"></span>
                <div class="form-text">Để trống nếu không giới hạn.</div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="MinOrderValue" class="form-label"></label>
                <input asp-for="MinOrderValue" type="number" min="0" step="1" class="form-control" />
                <span asp-validation-for="MinOrderValue" class="text-danger small"></span>
                <div class="form-text">Nhập 0 nếu áp dụng cho mọi đơn.</div>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="UsageLimit" class="form-label"></label>
                <input asp-for="UsageLimit" type="number" min="1" step="1" class="form-control" />
                <span asp-validation-for="UsageLimit" class="text-danger small"></span>
                <div class="form-text">Để trống nếu không giới hạn lượt dùng.</div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
                <div class="form-text">Mã dùng được đến hết ngày này.</div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Trạng thái</label>
            <div class="form-check mt-2">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu</button>
            <a asp-action="Index" class="btn btn-light">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Giảm theo % thì hiện ô "Giảm tối đa"; giảm số tiền cố định thì ẩn ô đó đi
        (function () {
            var kieu = document.getElementById('kieuGiam');
            var tran = document.getElementById('khungTran');
            var nhan = document.getElementById('nhanGiaTri');

            function capNhat() {
                var phanTram = kieu.value === '@((int)DiscountType.PhanTram)';
                tran.style.display = phanTram ? '' : 'none';
                nhan.textContent = phanTram ? 'Giá trị giảm (%)' : 'Giá trị giảm (VNĐ)';
            }

            kieu.addEventListener('change', capNhat);
            capNhat();
        })();
    </script>
}
