@model CartViewModel
@using ShopBanHang.Helpers
@{
    bool daDangNhap = User.Identity?.IsAuthenticated == true;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li>
    </ol>
</nav>

<h1 class="h4 mb-3"><i class="bi bi-cart3"></i> Giỏ hàng</h1>

@if (Model.TrongRong)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-cart-x display-4 text-muted"></i>
            <p class="mt-3 mb-4">Giỏ hàng của bạn đang trống.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-mc-cta">Mua sắm ngay</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-end" style="width:130px">Đơn giá</th>
                                <th class="text-center" style="width:150px">Số lượng</th>
                                <th class="text-end" style="width:140px">Thành tiền</th>
                                <th style="width:50px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in Model.Lines)
                            {
                                <tr class="@(l.CanhBao != null ? "table-warning" : "")">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@l.ImageUrl" alt="@l.ProductName" class="rounded border"
                                                 style="width:64px;height:64px;object-fit:contain;background:#fff" />
                                            <div>
                                                <a asp-controller="Product" asp-action="Detail" asp-route-slug="@l.Slug"
                                                   class="fw-semibold text-decoration-none">@l.ProductName</a>
                                                <div class="small text-muted">@l.VariantName</div>
                                                @if (l.CanhBao != null)
                                                {
                                                    <div class="small text-danger mt-1">
                                                        <i class="bi bi-exclamation-triangle"></i> @l.CanhBao
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="text-danger fw-semibold">@TienViet.Dinh(l.UnitPrice)</div>
                                        @if (TienViet.PhanTramGiam(l.UnitPrice, l.OldPrice) > 0)
                                        {
                                            <del class="small text-muted">@TienViet.Dinh(l.OldPrice)</del>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @* Đổi số là tự gửi form, không cần nút "Cập nhật" *@
                                        <form asp-action="Update" method="post" class="d-inline-flex">
                                            <input type="hidden" name="id" value="@l.CartItemId" />
                                            <input type="number" name="soLuong" value="@l.Quantity" min="1"
                                                   max="@Math.Max(1, Math.Min(99, l.Stock))"
                                                   class="form-control form-control-sm text-center js-tu-gui"
                                                   style="width:80px" aria-label="Số lượng" />
                                        </form>
                                        @if (l.DangBan && l.Stock > 0)
                                        {
                                            <div class="small text-muted mt-1">Còn @l.Stock</div>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">@TienViet.Dinh(l.LineTotal)</td>
                                    <td class="text-end">
                                        <form asp-action="Remove" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@l.CartItemId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xoá khỏi giỏ">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <a asp-controller="Product" asp-action="Index" class="btn btn-light">
                    <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                </a>
                <form asp-action="Clear" method="post" onsubmit="return confirm('Xoá toàn bộ giỏ hàng?');">
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Xoá hết
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h6 mb-3">Tóm tắt</h2>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Số lượng</span>
                        <span>@Model.TongSoLuong sản phẩm</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Tạm tính</span>
                        <span class="h5 text-danger fw-bold mb-0">@TienViet.Dinh(Model.TamTinh)</span>
                    </div>
                    <p class="small text-muted">Mã giảm giá nhập ở bước đặt hàng.</p>

                    @if (Model.CoVanDe)
                    {
                        <div class="alert alert-warning small py-2">
                            Có sản phẩm hết hàng hoặc vượt tồn kho. Vui lòng sửa các dòng được tô vàng trước khi đặt hàng.
                        </div>
                        <button class="btn btn-mc-cta w-100" disabled>Tiến hành đặt hàng</button>
                    }
                    else
                    {
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-mc-cta w-100">
                            Tiến hành đặt hàng <i class="bi bi-arrow-right"></i>
                        </a>
                        @if (!daDangNhap)
                        {
                            <p class="small text-muted mt-2 mb-0">
                                Không cần tài khoản vẫn đặt được.
                                <a asp-controller="Account" asp-action="Login"
                                   asp-route-returnUrl="@Url.Action("Index", "Cart")">Đăng nhập</a>
                                để dùng sổ địa chỉ và theo dõi đơn dễ hơn — giỏ hàng được giữ nguyên.
                            </p>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.js-tu-gui').forEach(function (el) {
            el.addEventListener('change', function () { this.form.submit(); });
        });
    </script>
}
