@{
    var banners = ViewBag.Banners as List<Banner> ?? new List<Banner>();
    var noiBat = ViewBag.NoiBat as List<Product> ?? new List<Product>();
    var moiNhat = ViewBag.MoiNhat as List<Product> ?? new List<Product>();
    var cacThuongHieu = ViewBag.CacThuongHieu as List<Brand>  ?? new List<Brand>();
    var banChay = ViewBag.BanChay as List<Product> ?? new List<Product>();
}

@* ===== Slideshow banner, dữ liệu do admin quản lý ở /Admin/Banner ===== *@
@if (banners.Any())
{
    <div id="bannerSlide" class="carousel slide shadow-sm mb-5 rounded-4 overflow-hidden" data-bs-ride="carousel" data-bs-interval="4000">
        
        <!-- Thanh chỉ báo (Indicators) dạng chấm tròn hiện đại -->
        <div class="carousel-indicators mb-2">
            @for (int i = 0; i < banners.Count; i++)
            {
                <button type="button" data-bs-target="#bannerSlide" data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "") rounded-circle" 
                        style="width: 10px; height: 10px; border: none; background-color: rgba(255,255,255,0.6); transition: all 0.3s;"
                        aria-label="Banner @(i + 1)"></button>
            }
        </div>

        <!-- Khung chứa các Slide ảnh -->
        <div class="carousel-inner" style="max-height: 420px; background-color: #f8f9fa;">
            @for (int i = 0; i < banners.Count; i++)
            {
                var bn = banners[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    @if (!string.IsNullOrEmpty(bn.LinkUrl))
                    {
                        <a href="@bn.LinkUrl">
                            <img src="@bn.ImageUrl" class="d-block w-100 object-fit-cover" style="height: 420px;" alt="@bn.Title" />
                        </a>
                    }
                    else
                    {
                        <img src="@bn.ImageUrl" class="d-block w-100 object-fit-cover" style="height: 420px;" alt="@bn.Title" />
                    }
                </div>
            }
        </div>

        <!-- Nút chuyển Slide Trước (Previous) -->
        <button class="carousel-control-prev" type="button" data-bs-target="#bannerSlide" data-bs-slide="prev">
            <span class="carousel-control-prev-icon bg-dark bg-opacity-50 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;"></span>
            <span class="visually-hidden">Trước</span>
        </button>

        <!-- Nút chuyển Slide Sau (Next) -->
        <button class="carousel-control-next" type="button" data-bs-target="#bannerSlide" data-bs-slide="next">
            <span class="carousel-control-next-icon bg-dark bg-opacity-50 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;"></span>
            <span class="visually-hidden">Sau</span>
        </button>
    </div>
}

@* ===== Sản phẩm theo hãng ===== *@
<div class="brand-nav mb-4">
    <a asp-controller="Product"
       asp-action="Index"
       class="brand-item">
        Tất cả
    </a>

   
    @foreach (var brand in cacThuongHieu)
    {
        <a asp-controller="Product"
           asp-action="Index"
           asp-route-ThuongHieu="@brand.Slug"
           class="brand-item">

            @if (!string.IsNullOrEmpty(brand.LogoUrl))
            {
                <img src="@brand.LogoUrl"
                     alt="@brand.Name"
                     class="adm-logo-thumb"
                     style="width:60px;height:34px;object-fit:contain" />
            }
            else
            {
                <span class="text-muted small">—</span>
            }
        </a>
    }
</div>



@* ===== Sản phẩm nổi bật ===== *@
@if (noiBat.Any())
{
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 mb-0"><i class="bi bi-star-fill mc-text-gold"></i> Sản phẩm nổi bật</h2>
        <a asp-controller="Product" asp-action="Index" class="small text-decoration-none mc-suggest-item">Xem tất cả</a>
    </div>

    <div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
        @foreach (var sp in noiBat)
        {
            <div class="col">
                <partial name="_ProductCard" model="sp" />
            </div>
        }
    </div>
}

@* ===== Sản phẩm bán chạy ===== *@
@if (banChay.Any())
{
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-fire mc-text-gold"></i>
            Điện thoại bán chạy
        </h2>

        <a asp-controller="Product"
           asp-action="Index"
           asp-route-SapXep="@((int)ProductSort.BanChay)"
           class="small text-decoration-none mc-suggest-item">
            Xem tất cả
        </a>
    </div>

    <div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
        @foreach (var sp in banChay)
        {
            <div class="col">
                <partial name="_ProductCard" model="sp" />
            </div>
        }
    </div>
}

@* ===== Sản phẩm mới nhất ===== *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-clock-history mc-text-gold"></i> Sản phẩm mới nhất</h2>
    <a asp-controller="Product" asp-action="Index" class="small text-decoration-none mc-suggest-item">Xem tất cả</a>
</div>

@if (moiNhat.Any())
{
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var sp in moiNhat)
        {
            <div class="col">
                <partial name="_ProductCard" model="sp" />
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-light border">Chưa có sản phẩm nào.</div>
}
