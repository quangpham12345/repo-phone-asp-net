@{
    var banners = ViewBag.Banners as List<Banner> ?? new List<Banner>();
    var noiBat = ViewBag.NoiBat as List<Product> ?? new List<Product>();
    var moiNhat = ViewBag.MoiNhat as List<Product> ?? new List<Product>();
    var cacThuongHieu = ViewBag.CacThuongHieu as List<Brand> ?? new List<Brand>();
    var banChay = ViewBag.BanChay as List<Product> ?? new List<Product>();
    ViewData["Title"] = "Trang chủ";
}

@if (banners.Any())
{
    <div id="bannerSlide" class="carousel slide hh-banner" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-indicators">
            @for (int i = 0; i < banners.Count; i++)
            {
                <button type="button" data-bs-target="#bannerSlide" data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "")" aria-label="Banner @(i + 1)"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (int i = 0; i < banners.Count; i++)
            {
                var bn = banners[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@bn.ImageUrl" class="d-block w-100" alt="@bn.Title" />
                    <div class="hh-banner-caption">
                        <div class="hh-banner-caption-inner">
                            @if (!string.IsNullOrWhiteSpace(bn.Title))
                            {
                                <h2 class="hh-banner-title">@bn.Title</h2>
                            }
                            @if (!string.IsNullOrEmpty(bn.LinkUrl))
                            {
                                <a href="@bn.LinkUrl" class="hh-banner-cta">
                                    Xem ngay <i class="bi bi-arrow-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#bannerSlide" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="visually-hidden">Trước</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#bannerSlide" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="visually-hidden">Sau</span>
        </button>
    </div>
}

@if (cacThuongHieu.Any())
{
    <div class="brand-nav">
        <a asp-controller="Product" asp-action="Index" class="brand-item">
            <strong>Tất cả</strong>
        </a>
        @foreach (var brand in cacThuongHieu)
        {
            <a asp-controller="Product" asp-action="Index" asp-route-ThuongHieu="@brand.Slug" class="brand-item">
                @if (!string.IsNullOrEmpty(brand.LogoUrl))
                {
                    <img src="@brand.LogoUrl" alt="@brand.Name"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='inline';" />
                    <span style="display:none">@brand.Name</span>
                }
                else
                {
                    @brand.Name
                }
            </a>
        }
    </div>
}

@if (noiBat.Any())
{
    <div class="section-header">
        <h2 class="section-title"><i class="bi bi-star-fill"></i> Sản phẩm nổi bật</h2>
        <a asp-controller="Product" asp-action="Index" class="section-link">Xem tất cả <i class="bi bi-chevron-right"></i></a>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3 mb-5">
        @foreach (var sp in noiBat)
        {
            <div class="col">
                <partial name="_ProductCard" model="sp" />
            </div>
        }
    </div>
}

@if (banChay.Any())
{
    <div class="section-header">
        <h2 class="section-title"><i class="bi bi-fire"></i> Điện thoại bán chạy</h2>
        <a asp-controller="Product" asp-action="Index" asp-route-SapXep="@((int)ProductSort.BanChay)" class="section-link">
            Xem tất cả <i class="bi bi-chevron-right"></i>
        </a>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3 mb-5">
        @foreach (var sp in banChay)
        {
            <div class="col">
                <partial name="_ProductCard" model="sp" />
            </div>
        }
    </div>
}

<div class="section-header">
    <h2 class="section-title"><i class="bi bi-lightning-charge-fill"></i> Sản phẩm mới nhất</h2>
    <a asp-controller="Product" asp-action="Index" class="section-link">Xem tất cả <i class="bi bi-chevron-right"></i></a>
</div>

@if (moiNhat.Any())
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3">
        @foreach (var sp in moiNhat)
        {
            <div class="col">
                <partial name="_ProductCard" model="sp" />
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-light border text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted"></i>
        <p class="mb-0 mt-2">Chưa có sản phẩm nào.</p>
    </div>
}