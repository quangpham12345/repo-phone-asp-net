@model MyOrderDetailViewModel
@using ShopBanHang.Helpers
@{
    var don = Model.Don;
}

<div class="card shadow-sm mb-4">
    <div class="card-body text-center py-4">
        <i class="bi bi-check-circle-fill text-success display-4"></i>
        <h1 class="h4 mt-3">Đặt hàng thành công!</h1>
        <p class="mb-1">
            Mã đơn của bạn: <b class="fs-5"><code>@don.OrderCode</code></b>
        </p>
        <p class="text-muted mb-0">
            @if (don.PaymentMethod == PaymentMethod.COD)
            {
                <text>Shop sẽ gọi điện xác nhận và giao hàng. Bạn thanh toán <b>@TienViet.Dinh(don.Total)</b> khi nhận hàng.</text>
            }
            else
            {
                <text>Vui lòng chuyển khoản theo mã QR bên dưới để shop xử lý đơn.</text>
            }
        </p>
    </div>
</div>

<partial name="_QrThanhToan" model="Model" />

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h6 mb-3">Thông tin đơn</h2>
        <dl class="row small mb-0">
            <dt class="col-sm-3">Người nhận</dt>
            <dd class="col-sm-9">@don.CustomerName · @don.Phone</dd>
            <dt class="col-sm-3">Địa chỉ</dt>
            <dd class="col-sm-9">@don.Address</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@don.Email</dd>
            <dt class="col-sm-3">Thanh toán</dt>
            <dd class="col-sm-9">@don.PaymentMethod.Nhan()</dd>
        </dl>
    </div>
    <partial name="_DongHangDon" model="don" />
</div>

@if (Model.LaKhachLe)
{
    <div class="alert alert-info small">
        <i class="bi bi-info-circle"></i> Bạn đặt hàng không cần tài khoản. Hãy <b>lưu lại mã đơn @don.OrderCode</b>:
        để xem lại đơn sau này, vào <a asp-controller="Order" asp-action="Lookup">Tra cứu đơn hàng</a>
        và nhập mã đơn cùng số điện thoại <b>@don.Phone</b>.
    </div>
}

<div class="d-flex gap-2 justify-content-center">
    @if (Model.LaKhachLe)
    {
        <a asp-controller="Order" asp-action="Guest" asp-route-code="@don.OrderCode" class="btn btn-mc-cta">
            Xem đơn hàng
        </a>
    }
    else
    {
        <a asp-controller="Order" asp-action="Detail" asp-route-code="@don.OrderCode" class="btn btn-mc-cta">
            Xem đơn hàng
        </a>
    }
    <a asp-controller="Product" asp-action="Index" class="btn btn-light">Tiếp tục mua sắm</a>
</div>
