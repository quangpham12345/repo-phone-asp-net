@model ProductDetailViewModel
@using ShopBanHang.Helpers
@{
    var sp = Model.SanPham;

    // Giá và tồn kho lấy từ biến thể. Phần hiển thị ban đầu là giá thấp nhất; khách chọn dung lượng/màu
    // thì script ở cuối trang đổi giá, tồn kho và ảnh theo biến thể đang chọn.
    int phanTramGiam = TienViet.PhanTramGiam(sp.DisplayPrice, sp.DisplayOldPrice);
    bool hetHang = sp.TotalStock <= 0;

    var cacBienThe = sp.Variants
        .Where(v => v.IsActive)
        .OrderBy(v => TongHopBienThe.GiaTriGB(v.Storage)).ThenBy(v => v.Color)
        .ToList();
    var duLieuBienThe = cacBienThe.Select(v => new
    {
        id = v.Id,
        storage = v.Storage,
        color = v.Color,
        price = v.Price,
        oldPrice = v.OldPrice,
        stock = v.Stock,
        image = v.ImageUrl
    });

    var thongSo = new List<(string Nhan, string? GiaTri)>
    {
        ("Thương hiệu", sp.Brand?.Name),
        ("Danh mục", sp.Category?.Name),
        ("Màn hình", sp.Screen),
        ("Chip", sp.Chip),
        ("RAM", sp.Ram),
        ("Dung lượng", sp.StorageOptions.Any() ? string.Join(", ", sp.StorageOptions) : null),
        ("Màu sắc", sp.ColorOptions.Any() ? string.Join(", ", sp.ColorOptions) : null),
        ("Camera", sp.Camera),
        ("Pin", sp.Battery),
        ("Hệ điều hành", sp.Os)
    }.Where(x => !string.IsNullOrWhiteSpace(x.GiaTri)).ToList();
    var anh = sp.TatCaAnh;
    if (anh.Count == 0) anh.Add("/images/products/no-image.svg");
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item">
            <a asp-controller="Product" asp-action="Index" asp-route-danhMuc="@sp.Category?.Slug">
                @sp.Category?.Name
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@sp.Name</li>
    </ol>
</nav>

<div class="card shadow-sm mb-4">
    <div class="row g-0">
        <div class="col-md-5 p-3">
            <div class="mb-2 text-center">
                <img id="anhChinh" src="@anh[0]" class="img-fluid rounded" style="max-height:360px;object-fit:contain" alt="@sp.Name" />
            </div>
            @if (anh.Count > 1)
            {
                <div class="d-flex gap-2 flex-wrap justify-content-center">
                    @for (int i = 0; i < anh.Count; i++)
                    {
                        <img src="@anh[i]" class="rounded border thumb-gallery @(i == 0 ? "border-primary" : "")"
                             style="width:64px;height:64px;object-fit:cover;cursor:pointer"
                             data-src="@anh[i]" alt="Ảnh @(i + 1)" />
                    }
                </div>
            }
        </div>

        <div class="col-md-7 p-4">
            <h1 class="h4">@sp.Name</h1>

            <div class="small text-muted mb-3">
                Thương hiệu <b>@sp.Brand?.Name</b> ·
                Danh mục <b>@sp.Category?.Name</b> ·
                Đã bán <b>@sp.SoldCount</b>
                @if (Model.SoLuotDanhGia > 0)
                {
                    <text> · </text>
                    <span class="text-warning">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= Math.Round(Model.DiemTrungBinh) ? "bi-star-fill" : "bi-star")"></i>
                        }
                    </span>
                    <b>@Model.DiemTrungBinh</b> <text>(@Model.SoLuotDanhGia lượt)</text>
                }
            </div>

            @if (!sp.HasVariants)
            {
                <div class="mb-3">
                    <span class="h5 text-muted">Đang cập nhật giá</span>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <span id="giaBan" class="h3 text-danger fw-bold">@TienViet.Dinh(sp.DisplayPrice)</span>
                    <del id="giaGoc" class="text-muted ms-2 @(phanTramGiam > 0 ? "" : "d-none")">@TienViet.Dinh(sp.DisplayOldPrice)</del>
                    <span id="phanTramGiam" class="badge bg-danger ms-2 @(phanTramGiam > 0 ? "" : "d-none")">-@phanTramGiam%</span>
                </div>
            }

            <div class="mb-3">
                <span id="tonKho" class="badge @(hetHang ? "bg-secondary" : "bg-success")">
                    @(hetHang ? "Hết hàng" : "Còn " + sp.TotalStock + " sản phẩm")
                </span>
            </div>

            @if (cacBienThe.Count > 0)
            {
                @* Nút chọn dung lượng và màu do script vẽ từ dữ liệu JSON này *@
                <div class="mb-3">
                    <div class="small fw-semibold mb-2">Dung lượng</div>
                    <div id="dsDungLuong" class="d-flex flex-wrap gap-2"></div>
                </div>
                <div class="mb-3">
                    <div class="small fw-semibold mb-2">Màu sắc</div>
                    <div id="dsMau" class="d-flex flex-wrap gap-2"></div>
                </div>
                <script type="application/json" id="bienTheData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(duLieuBienThe))</script>
            }

            @if (!string.IsNullOrWhiteSpace(sp.Description))
            {
                <p class="mb-4">@sp.Description</p>
            }

            <div class="d-flex gap-2 flex-wrap">
                @* GIAI ĐOẠN SAU: hai nút này sẽ gọi AJAX thêm vào giỏ hàng *@
                <button id="btnThemGio" class="btn btn-mc-cta" disabled="@hetHang">
                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                </button>
                <a asp-controller="Product" asp-action="Index" class="btn btn-light">
                    Xem sản phẩm khác
                </a>
            </div>
            <div class="form-text mt-2">Chức năng giỏ hàng sẽ làm ở giai đoạn sau.</div>
        </div>
    </div>
</div>

<div class="spec-card mb-4">
    <div class="spec-header">
        <div class="spec-header-icon">
            <i class="bi bi-cpu"></i>
        </div>
        <div>
            <h5 class="mb-1">Thông số kỹ thuật</h5>
            <p class="mb-0">Thông tin chi tiết về sản phẩm</p>
        </div>
    </div>

    <div class="spec-body">
        <div class="spec-grid">
            @foreach (var (nhan, giaTri) in thongSo)
            {
                var icon = nhan switch
                {
                    "Thương hiệu" => "bi-award",
                    "Danh mục" => "bi-grid",
                    "Màn hình" => "bi-display",
                    "Chip" => "bi-cpu",
                    "RAM" => "bi-memory",
                    "Dung lượng" => "bi-device-ssd",
                    "Màu sắc" => "bi-palette",
                    "Camera" => "bi-camera",
                    "Pin" => "bi-battery-full",
                    "Hệ điều hành" => "bi-android2",
                    _ => "bi-info-circle"
                };

                <div class="spec-item">
                    <div class="spec-item-icon">
                        <i class="bi @icon"></i>
                    </div>
                    <div class="spec-item-content">
                        <span class="spec-label">@nhan</span>
                        <span class="spec-value">@giaTri</span>
                    </div>
                </div>
            }
        </div>

        <div class="spec-divider"></div>

        <div class="spec-summary">
            <div class="spec-summary-item">
                <div class="summary-icon stock-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <span class="summary-label">Tồn kho</span>
                    @if (sp.TotalStock > 0)
                    {
                        <span class="summary-value text-success">
                            Còn @sp.TotalStock sản phẩm
                        </span>
                    }
                    else
                    {
                        <span class="summary-value text-danger">Hết hàng</span>
                    }
                </div>
            </div>

            <div class="spec-summary-item">
                <div class="summary-icon sold-icon">
                    <i class="bi bi-cart-check"></i>
                </div>
                <div>
                    <span class="summary-label">Đã bán</span>
                    <span class="summary-value">@sp.SoldCount sản phẩm</span>
                </div>
            </div>
        </div>
    </div>
</div>
@* ===== Đánh giá sản phẩm ===== *@
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">
            Đánh giá sản phẩm
            @if (Model.SoLuotDanhGia > 0)
            {
                <span class="text-muted small">— @Model.DiemTrungBinh/5 từ @Model.SoLuotDanhGia lượt</span>
            }
        </h2>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="alert alert-light border py-2 small mb-3">
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                để đánh giá sản phẩm này.
            </div>
        }
        else if (!Model.DuocDanhGia)
        {
            @* Chốt chặn thật nằm ở service, đây chỉ là lời giải thích cho khách *@
            <div class="alert alert-light border py-2 small mb-3">
                <i class="bi bi-info-circle"></i>
                Chỉ khách đã mua và nhận hàng thành công sản phẩm này mới được đánh giá.
            </div>
        }
        else
        {
            <form asp-action="Review" method="post" class="border rounded p-3 mb-3">
                <input type="hidden" name="productId" value="@sp.Id" />
                <input type="hidden" name="slug" value="@sp.Slug" />

                <div class="mb-2">
                    <label class="form-label mb-1">Số sao</label>
                    <select name="soSao" class="form-select form-select-sm" style="max-width:160px">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <option value="@i" selected="@(Model.DanhGiaCuaToi?.Rating == i)">@i sao</option>
                        }
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label mb-1">Nhận xét</label>
                    <textarea name="nhanXet" class="form-control" rows="3" maxlength="1000"
                              placeholder="Máy dùng thế nào?">@Model.DanhGiaCuaToi?.Comment</textarea>
                </div>

                <button type="submit" class="btn btn-sm btn-mc-cta">
                    <i class="bi bi-send"></i>
                    @(Model.DanhGiaCuaToi == null ? "Gửi đánh giá" : "Cập nhật đánh giá")
                </button>

                @if (Model.DanhGiaCuaToi != null)
                {
                    <span class="small text-muted ms-2">Bạn đã đánh giá sản phẩm này.</span>
                }
            </form>

            @if (Model.DanhGiaCuaToi != null)
            {
                <form asp-action="ReviewDelete" method="post" class="mb-3"
                      onsubmit="return confirm('Xoa danh gia cua ban?');">
                    <input type="hidden" name="productId" value="@sp.Id" />
                    <input type="hidden" name="slug" value="@sp.Slug" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i> Xoá đánh giá của tôi
                    </button>
                </form>
            }
        }

        @if (!Model.DanhGia.Any())
        {
            <p class="text-muted small mb-0">Chưa có đánh giá nào cho sản phẩm này.</p>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var dg in Model.DanhGia)
                {
                    <div class="border-bottom pb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <b>@(dg.User?.FullName ?? "Khách hàng")</b>
                            <span class="small text-muted">@dg.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="text-warning small">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= dg.Rating ? "bi-star-fill" : "bi-star")"></i>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(dg.Comment))
                        {
                            <div class="small mt-1">@dg.Comment</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (Model.LienQuan.Any())
{
    <h2 class="h5 mb-3">Sản phẩm cùng danh mục</h2>
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var lq in Model.LienQuan)
        {
            <div class="col">
                <partial name="_ProductCard" model="lq" />
            </div>
        }
    </div>
}


@section Scripts {
    <script>
        document.querySelectorAll('.thumb-gallery').forEach(function (el) {
            el.addEventListener('click', function () {
                document.getElementById('anhChinh').src = this.dataset.src;
                document.querySelectorAll('.thumb-gallery').forEach(t => t.classList.remove('border-primary'));
                this.classList.add('border-primary');
            });
        });

        // ===== Chọn biến thể (dung lượng x màu): đổi giá, tồn kho, ảnh theo biến thể đang chọn =====
        (function () {
            var nguon = document.getElementById('bienTheData');
            if (!nguon) return;

            var ds = JSON.parse(nguon.textContent);
            if (ds.length === 0) return;

            var boxDungLuong = document.getElementById('dsDungLuong');
            var boxMau = document.getElementById('dsMau');
            var elGia = document.getElementById('giaBan');
            var elGiaGoc = document.getElementById('giaGoc');
            var elGiam = document.getElementById('phanTramGiam');
            var elTon = document.getElementById('tonKho');
            var btnGio = document.getElementById('btnThemGio');
            var anhChinh = document.getElementById('anhChinh');

            var dinhDang = function (n) { return Number(n).toLocaleString('de-DE') + ' đ'; };

            // Thứ tự dung lượng giữ đúng như server đã xếp (nhỏ đến lớn)
            var cacDungLuong = [];
            ds.forEach(function (v) {
                if (cacDungLuong.indexOf(v.storage) === -1) cacDungLuong.push(v.storage);
            });

            function theoDungLuong(dl) {
                return ds.filter(function (v) { return v.storage === dl; });
            }

            // Mặc định chọn biến thể rẻ nhất còn hàng; hết sạch hàng thì chọn biến thể rẻ nhất
            var conHang = ds.filter(function (v) { return v.stock > 0; });
            var chon = (conHang.length > 0 ? conHang : ds).reduce(function (a, b) {
                return a.price > b.price ? b : a;
            });

            function taoNut(nhan, dangChon, hetHang, onClick) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'btn btn-sm ' + (dangChon ? 'btn-outline-primary active' : 'btn-outline-secondary')
                            + (hetHang ? ' opacity-50' : '');
                b.textContent = nhan;
                if (hetHang) b.title = 'Hết hàng';
                b.addEventListener('click', onClick);
                return b;
            }

            function veNut() {
                boxDungLuong.innerHTML = '';
                cacDungLuong.forEach(function (dl) {
                    var het = theoDungLuong(dl).every(function (v) { return v.stock <= 0; });
                    boxDungLuong.appendChild(taoNut(dl, dl === chon.storage, het, function () {
                        if (dl === chon.storage) return;
                        var cungDl = theoDungLuong(dl);
                        // Giữ màu đang chọn nếu dung lượng mới có màu đó, không thì lấy biến thể còn hàng đầu tiên
                        var cungMau = cungDl.filter(function (v) { return v.color === chon.color; })[0];
                        var conHangDl = cungDl.filter(function (v) { return v.stock > 0; })[0];
                        chon = cungMau || conHangDl || cungDl[0];
                        capNhat();
                    }));
                });

                boxMau.innerHTML = '';
                theoDungLuong(chon.storage).forEach(function (v) {
                    boxMau.appendChild(taoNut(v.color, v.id === chon.id, v.stock <= 0, function () {
                        chon = v;
                        capNhat();
                    }));
                });
            }

            function capNhat() {
                veNut();

                elGia.textContent = dinhDang(chon.price);
                var giam = (chon.oldPrice && chon.oldPrice > chon.price)
                    ? Math.floor((chon.oldPrice - chon.price) / chon.oldPrice * 100) : 0;
                elGiaGoc.classList.toggle('d-none', giam === 0);
                elGiam.classList.toggle('d-none', giam === 0);
                if (giam > 0) {
                    elGiaGoc.textContent = dinhDang(chon.oldPrice);
                    elGiam.textContent = '-' + giam + '%';
                }

                if (chon.stock > 0) {
                    elTon.className = 'badge bg-success';
                    elTon.textContent = 'Còn ' + chon.stock + ' sản phẩm';
                } else {
                    elTon.className = 'badge bg-secondary';
                    elTon.textContent = 'Hết hàng';
                }

                // Giai đoạn giỏ hàng sẽ đọc data-variant-id để biết khách đang mua biến thể nào
                if (btnGio) {
                    btnGio.disabled = chon.stock <= 0;
                    btnGio.dataset.variantId = chon.id;
                }

                // Biến thể có ảnh riêng thì đổi ảnh chính theo
                if (chon.image && anhChinh) {
                    anhChinh.src = chon.image;
                    document.querySelectorAll('.thumb-gallery').forEach(function (t) {
                        t.classList.toggle('border-primary', t.dataset.src === chon.image);
                    });
                }
            }

            capNhat();
        })();
    </script>
}