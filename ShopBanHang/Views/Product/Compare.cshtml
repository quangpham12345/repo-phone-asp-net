@model ProductCompareViewModel
@using ShopBanHang.Helpers

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
        <li class="breadcrumb-item active">So sánh</li>
    </ol>
</nav>

<h1 class="h4 mb-4">So sánh sản phẩm</h1>

@if (Model.SanPham.Count < 2)
{
    <div class="alert alert-warning">Cần ít nhất 2 sản phẩm để so sánh.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th class="text-start">Thông số</th>
                    @foreach (var sp in Model.SanPham)
                    {
                        <th style="min-width:180px">
                            <a asp-action="Detail" asp-route-slug="@sp.Slug" class="text-decoration-none">
                                <img src="@(string.IsNullOrEmpty(sp.ImageUrl) ? "/images/products/no-image.svg" : sp.ImageUrl)"
                                     alt="@sp.Name" class="img-fluid mb-2 rounded" style="max-height:120px;object-fit:contain" />
                                <div class="small fw-semibold">@sp.Name</div>
                            </a>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-start fw-semibold">Giá bán</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td class="text-danger fw-bold">
                            @if (sp.HasVariants)
                            {
                                @(sp.HasPriceRange ? "Từ " : "")@TienViet.Dinh(sp.DisplayPrice)
                            }
                            else
                            {
                                <span class="text-muted fw-normal">Đang cập nhật</span>
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <td class="text-start fw-semibold">Giá gốc</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td>@(sp.DisplayOldPrice.HasValue ? TienViet.Dinh(sp.DisplayOldPrice) : "—")</td>
                    }
                </tr>
                <tr>
                    <td class="text-start fw-semibold">Thương hiệu</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td>@(sp.Brand?.Name ?? "—")</td>
                    }
                </tr>
                <tr>
                    <td class="text-start fw-semibold">Danh mục</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td>@(sp.Category?.Name ?? "—")</td>
                    }
                </tr>
                <tr>
                    <td class="text-start fw-semibold">Màu sắc</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td>@(sp.ColorOptions.Any() ? string.Join(", ", sp.ColorOptions) : "—")</td>
                    }
                </tr>
                <tr>
                    <td class="text-start fw-semibold">RAM</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td>@(sp.Ram ?? "—")</td>
                    }
                </tr>
                <tr>
                    <td class="text-start fw-semibold">Dung lượng</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td>@(sp.StorageOptions.Any() ? string.Join(", ", sp.StorageOptions) : "—")</td>
                    }
                </tr>
                <tr>
                    <td class="text-start fw-semibold">Hệ điều hành</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td>@(sp.Os ?? "—")</td>
                    }
                </tr>
                <tr>
                    <td class="text-start fw-semibold">Tồn kho</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td>@(sp.TotalStock > 0 ? sp.TotalStock.ToString() : "Hết hàng")</td>
                    }
                </tr>
                <tr>
                    <td class="text-start fw-semibold">Đã bán</td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td>@sp.SoldCount</td>
                    }
                </tr>
                <tr>
                    <td class="text-start"></td>
                    @foreach (var sp in Model.SanPham)
                    {
                        <td><a asp-action="Detail" asp-route-slug="@sp.Slug" class="btn btn-sm btn-mc-buy">Xem chi tiết</a></td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
}
<a asp-action="Index" class="btn btn-light mt-3"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
