@model ProductListViewModel
@using ShopBanHang.Helpers

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.TieuDe</li>
    </ol>
</nav>

@if (TempData["Loi"] != null)
{
    <div class="alert alert-warning">@TempData["Loi"]</div>
}

<div class="row">

    @* ===== Bộ lọc bên trái ===== *@
        <div class="col-lg-3 mb-3">
        <form asp-action="Index" method="get" class="card p-3">
            <input type="hidden" name="tuKhoa" value="@Model.Loc.TuKhoa" />
            <h2 class="h6">Danh mục</h2>
            <select name="danhMuc" class="form-select form-select-sm mb-3">
                <option value="">Tất cả danh mục</option>
                @foreach (var dm in Model.CacDanhMuc)
                {
                    <option value="@dm.Slug" selected="@(Model.Loc.DanhMuc == dm.Slug)">@dm.Name</option>
                }
            </select>
            <h2 class="h6">Thương hiệu</h2>
            <select name="thuongHieu" class="form-select form-select-sm mb-3">
                <option value="">Tất cả thương hiệu</option>
                @foreach (var th in Model.CacThuongHieu)
                {
                    <option value="@th.Slug" selected="@(Model.Loc.ThuongHieu == th.Slug)">@th.Name</option>
                }
            </select>
            <h2 class="h6">Khoảng giá</h2>
            <div class="d-flex gap-2 mb-3">
                <input type="number" name="giaTu" value="@Model.Loc.GiaTu" min="0" step="100000" class="form-control form-control-sm" placeholder="Từ" />
                <input type="number" name="giaDen" value="@Model.Loc.GiaDen" min="0" step="100000" class="form-control form-control-sm" placeholder="Đến" />
            </div>
            @if (Model.CacRam.Any())
            {
                <h2 class="h6">RAM</h2>
                <select name="ram" class="form-select form-select-sm mb-3">
                    <option value="">Tất cả</option>
                    @foreach (var r in Model.CacRam)
                    {
                        <option value="@r" selected="@(Model.Loc.Ram == r)">@r</option>
                    }
                </select>
            }
            @if (Model.CacStorage.Any())
            {
                <h2 class="h6">Dung lượng</h2>
                <select name="storage" class="form-select form-select-sm mb-3">
                    <option value="">Tất cả</option>
                    @foreach (var s in Model.CacStorage)
                    {
                        <option value="@s" selected="@(Model.Loc.Storage == s)">@s</option>
                    }
                </select>
            }
            @if (Model.CacOs.Any())
            {
                <h2 class="h6">Hệ điều hành</h2>
                <select name="os" class="form-select form-select-sm mb-3">
                    <option value="">Tất cả</option>
                    @foreach (var o in Model.CacOs)
                    {
                        <option value="@o" selected="@(Model.Loc.Os == o)">@o</option>
                    }
                </select>
            }

            <h2 class="h6">Sắp xếp</h2>
            <select name="sapXep" class="form-select form-select-sm mb-3">
                @foreach (ProductSort sx in Enum.GetValues<ProductSort>())
                {
                    <option value="@((int)sx)" selected="@(Model.Loc.SapXep == sx)">@sx.Nhan()</option>
                }
            </select>
            <button type="submit" class="btn btn-mc-buy btn-sm w-100">Áp dụng</button>
            <a asp-action="Index" class="btn btn-light btn-sm w-100 mt-2">Bỏ lọc</a>
        </form>
    </div>

    @* ===== Danh sách ===== *@
     <div class="col-lg-9">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <div class="text-muted small">@Model.KetQua.TotalItems sản phẩm</div>
                <div class="small text-secondary">
                    <i class="bi bi-info-circle"></i>
                    Tick ô trên mỗi sản phẩm (tối đa 3) rồi bấm <b>So sánh</b>
                </div>
            </div>

            <form id="formSoSanh" asp-action="Compare" method="get" class="d-none">
                <div id="compareIds"></div>
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-arrow-left-right"></i>
                    So sánh <span id="soLuongChon">0</span> sản phẩm
                </button>
            </form>
    </div>

        @if (!Model.KetQua.Items.Any())
        {
            <div class="alert alert-light border">Không có sản phẩm nào khớp bộ lọc.</div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-3 g-3 mb-4">
                @foreach (var sp in Model.KetQua.Items)
                {
                    <div class="col">
                        <div class="position-relative">
                            <partial name="_ProductCard" model="sp" />
                        </div>
                    </div>
                }
            </div>

            @if (Model.KetQua.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center flex-wrap">
                        <li class="page-item @(Model.KetQua.CoTrangTruoc ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.KetQua.Page - 1)"
                               asp-route-tuKhoa="@Model.Loc.TuKhoa" asp-route-danhMuc="@Model.Loc.DanhMuc"
                               asp-route-thuongHieu="@Model.Loc.ThuongHieu" asp-route-giaTu="@Model.Loc.GiaTu"
                               asp-route-giaDen="@Model.Loc.GiaDen" asp-route-ram="@Model.Loc.Ram"
                               asp-route-storage="@Model.Loc.Storage" asp-route-os="@Model.Loc.Os"
                               asp-route-sapXep="@((int)Model.Loc.SapXep)">&laquo;</a>
                        </li>
                        @for (int i = 1; i <= Model.KetQua.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.KetQua.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i"
                                   asp-route-tuKhoa="@Model.Loc.TuKhoa" asp-route-danhMuc="@Model.Loc.DanhMuc"
                                   asp-route-thuongHieu="@Model.Loc.ThuongHieu" asp-route-giaTu="@Model.Loc.GiaTu"
                                   asp-route-giaDen="@Model.Loc.GiaDen" asp-route-ram="@Model.Loc.Ram"
                                   asp-route-storage="@Model.Loc.Storage" asp-route-os="@Model.Loc.Os"
                                   asp-route-sapXep="@((int)Model.Loc.SapXep)">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.KetQua.CoTrangSau ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.KetQua.Page + 1)"
                               asp-route-tuKhoa="@Model.Loc.TuKhoa" asp-route-danhMuc="@Model.Loc.DanhMuc"
                               asp-route-thuongHieu="@Model.Loc.ThuongHieu" asp-route-giaTu="@Model.Loc.GiaTu"
                               asp-route-giaDen="@Model.Loc.GiaDen" asp-route-ram="@Model.Loc.Ram"
                               asp-route-storage="@Model.Loc.Storage" asp-route-os="@Model.Loc.Os"
                               asp-route-sapXep="@((int)Model.Loc.SapXep)">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@section Scripts {
<script>
(function () {
    const checks = document.querySelectorAll('.compare-check');
    const form = document.getElementById('formSoSanh');
    const box = document.getElementById('compareIds');
    function capNhat() {
        const chon = [...checks].filter(c => c.checked);
        box.innerHTML = '';
        chon.forEach(c => {
            const inp = document.createElement('input');
            inp.type = 'hidden'; inp.name = 'ids'; inp.value = c.value;
            box.appendChild(inp);
        });
       form.classList.toggle('d-none', chon.length < 2);
    const span = document.getElementById('soLuongChon');
    if (span) span.textContent = chon.length;
    if (chon.length > 3) {
        chon[chon.length - 1].checked = false;
        alert('Chỉ so sánh tối đa 3 sản phẩm.');
        capNhat();
    }
    }
    checks.forEach(c => c.addEventListener('change', capNhat));
})();
</script>
}