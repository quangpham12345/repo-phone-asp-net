@*
    Layout phía khách, port từ layout/header.html + footer.html của dự án Java.
    Chữ trên giao diện đi qua L["..."] để dịch theo ngôn ngữ đang chọn (i18n).
*@
@using System.Globalization
@{
    var ngonNgu = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;   // "vi" hoặc "en"
    var urlHienTai = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="@ngonNgu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopBanHang</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <script>
        // Ảnh nào tải lỗi (link hỏng, mất mạng) thì thay bằng ảnh "chưa có ảnh", không để ô trống.
        // Đặt trong <head> và bắt ở pha capture để không lỡ lỗi của ảnh tải sớm.
        document.addEventListener('error', function (e) {
            var img = e.target;
            if (img && img.tagName === 'IMG' && !img.dataset.loiAnh) {
                img.dataset.loiAnh = '1';
                img.src = '/images/products/no-image.svg';
            }
        }, true);
    </script>
</head>
<body>
    <!-- Top promo bar -->
    <div class="hh-topbar">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex gap-4">
                <span><i class="bi bi-truck"></i> @L["Miễn phí giao hàng toàn quốc"]</span>
                <span class="d-none d-md-inline"><i class="bi bi-shield-check"></i> @L["Bảo hành chính hãng"]</span>
            </div>
            <div class="d-flex gap-3 align-items-center">
                <a href="tel:19000000"><i class="bi bi-telephone"></i> 1900 0000</a>
                <a href="#" class="d-none d-sm-inline"><i class="bi bi-geo-alt"></i> @L["Hệ thống cửa hàng"]</a>

                @* Chọn ngôn ngữ: NgonNguController ghi cookie ".AspNetCore.Culture" rồi quay lại đúng trang *@
                <span class="hh-lang" title="@L["Ngôn ngữ"]">
                    <i class="bi bi-translate"></i>
                    <a asp-area="" asp-controller="NgonNgu" asp-action="Doi" asp-route-culture="vi-VN" asp-route-returnUrl="@urlHienTai"
                       class="@(ngonNgu == "vi" ? "fw-bold text-decoration-underline" : "")">VI</a>
                    |
                    <a asp-area="" asp-controller="NgonNgu" asp-action="Doi" asp-route-culture="en-US" asp-route-returnUrl="@urlHienTai"
                       class="@(ngonNgu == "en" ? "fw-bold text-decoration-underline" : "")">EN</a>
                </span>
            </div>
        </div>
    </div>

    <header class="hh-header">
        <div class="container">
            <div class="hh-mainbar d-flex align-items-center gap-3 gap-lg-4">
                <a asp-controller="Home" asp-action="Index" class="hh-logo">
                    <i class="bi bi-phone-fill"></i>
                    Shop<span>BanHang</span>
                </a>

                <form asp-controller="Product" asp-action="Index" method="get"
                      class="hh-search flex-grow-1 position-relative">
                    <div class="input-group">
                        <input type="text" name="tuKhoa" id="tuKhoaSearch" class="form-control"
                               value="@Context.Request.Query["tuKhoa"]"
                               placeholder="@L["Tìm điện thoại, laptop, phụ kiện..."]"
                               autocomplete="off" />
                        <button class="btn hh-btn-search" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <div id="goiYBox" class="list-group position-absolute w-100 shadow-lg rounded-3"
                         style="z-index:1050;display:none;top:calc(100% + 6px);max-height:360px;overflow:auto"></div>
                </form>

                <div class="hh-actions ms-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(Role.Admin))
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hh-action-btn">
                                <i class="bi bi-speedometer2"></i>
                                <span>@L["Quản trị"]</span>
                            </a>
                        }
                        <a asp-area="" asp-controller="Order" asp-action="Index" class="hh-action-btn">
                            <i class="bi bi-receipt"></i>
                            <span>@L["Đơn hàng"]</span>
                        </a>
                        <a asp-controller="Account" asp-action="Profile" class="hh-action-btn">
                            <i class="bi bi-person-circle"></i>
                            <span>@User.Identity.Name</span>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="hh-action-btn border-0 bg-transparent">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>@L["Thoát"]</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Order" asp-action="Lookup" class="hh-action-btn">
                            <i class="bi bi-search"></i>
                            <span>@L["Tra cứu đơn"]</span>
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="hh-action-btn">
                            <i class="bi bi-person"></i>
                            <span>@L["Tài khoản"]</span>
                        </a>
                    }

                    @* Nút giỏ hàng: ViewComponent tự đếm số lượng (CSDL hoặc Session) *@
                    @await Component.InvokeAsync("GioHang")
                </div>
            </div>
        </div>

        @await Component.InvokeAsync("MenuDanhMuc")
    </header>

    <div class="container my-4">
        @if (TempData["ThanhCong"] != null)
        {
            <div class="alert alert-success d-flex align-items-center py-2 mb-3">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["ThanhCong"]
            </div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center py-2 mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Loi"]
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="hh-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="logo-text">Shop<span>BanHang</span></div>
                    <p class="mb-3 small">@L["Hệ thống bán lẻ điện thoại, laptop & phụ kiện chính hãng. Cam kết giá tốt – bảo hành uy tín."]</p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                        <a href="#"><i class="bi bi-tiktok"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h5>@L["Danh mục"]</h5>
                    <a asp-controller="Product" asp-action="Index" asp-route-danhMuc="dien-thoai">@L["Điện thoại"]</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-danhMuc="tablet">@L["Tablet"]</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-danhMuc="laptop">@L["Laptop"]</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-danhMuc="phu-kien">@L["Phụ kiện"]</a>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <h5>@L["Hỗ trợ khách hàng"]</h5>
                    <a href="#">@L["Chính sách bảo hành"]</a>
                    <a href="#">@L["Chính sách đổi trả"]</a>
                    <a href="#">@L["Hướng dẫn mua hàng"]</a>
                    <a href="#">@L["Thanh toán & vận chuyển"]</a>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>@L["Liên hệ"]</h5>
                    <p class="mb-1 small"><i class="bi bi-telephone me-2"></i> Hotline: <strong class="text-white">1900 0000</strong></p>
                    <p class="mb-1 small"><i class="bi bi-envelope me-2"></i> contact@shopbanhang.local</p>
                    <p class="mb-0 small"><i class="bi bi-geo-alt me-2"></i> @L["Hà Nội, Việt Nam"]</p>
                </div>
            </div>
            <div class="hh-footer-bottom">
                &copy; 2026 ShopBanHang. @L["Bảo lưu mọi quyền."]
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>