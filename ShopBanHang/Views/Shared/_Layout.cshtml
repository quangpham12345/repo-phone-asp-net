@*
    Layout phía khách, port từ layout/header.html + footer.html của dự án Java.
*@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopBanHang</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>

    <header>
        <div class="mc-topbar py-2">
            <div class="container d-flex align-items-center gap-3 flex-wrap">

                <a asp-controller="Home" asp-action="Index" class="mc-logo text-decoration-none">
                    <i class="bi bi-phone"></i> Shop<span class="mc-text-gold">BanHang</span>
                </a>

                <form asp-controller="Product" asp-action="Index" method="get"
                      class="mc-search flex-grow-1 position-relative">
                    <div class="input-group">
                        <input type="text" name="tuKhoa" id="tuKhoaSearch" class="form-control"
                               value="@Context.Request.Query["tuKhoa"]"
                               placeholder="Bạn cần tìm máy nào?" aria-label="Tìm sản phẩm"
                               autocomplete="off" />
                        <button class="btn mc-btn-search" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <div id="goiYBox" class="list-group position-absolute w-100 shadow"
                         style="z-index:1050;display:none;top:100%;max-height:320px;overflow:auto"></div>
                </form>

                <div class="mc-toplinks ms-auto d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-white small text-nowrap d-none d-lg-inline">
                            <i class="bi bi-person-circle"></i> @User.Identity.Name
                        </span>

                        @if (User.IsInRole(Role.Admin))
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                               class="btn mc-btn-outline btn-sm">
                                <i class="bi bi-speedometer2"></i> Quản trị
                            </a>
                        }

                        <a asp-area="" asp-controller="Order" asp-action="Index" class="btn mc-btn-outline btn-sm">
                            <i class="bi bi-receipt"></i> <span class="d-none d-md-inline">Đơn hàng</span>
                        </a>

                        <a asp-controller="Account" asp-action="Profile" class="btn mc-btn-outline btn-sm">
                            <i class="bi bi-person"></i> Tài khoản
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn mc-btn-outline btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn mc-btn-outline btn-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn mc-btn-outline btn-sm">
                            <i class="bi bi-person-plus"></i> Đăng ký
                        </a>
                    }

                    @* Nút giỏ hàng tự đếm số lượng qua ViewComponent *@
                    @await Component.InvokeAsync("GioHang")
                </div>
            </div>
        </div>

        @* Thanh danh mục tự lấy dữ liệu từ CSDL qua ViewComponent *@
        @await Component.InvokeAsync("MenuDanhMuc")
    </header>

    <div class="container my-4">
        @if (TempData["ThanhCong"] != null)
        {
            <div class="alert alert-success py-2">
                <i class="bi bi-check-circle"></i> @TempData["ThanhCong"]
            </div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger py-2">
                <i class="bi bi-exclamation-triangle"></i> @TempData["Loi"]
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mc-topbar text-white py-4 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="mc-logo mb-2">Shop<span class="mc-text-gold">BanHang</span></div>
                    <p class="small mb-1">Hệ thống quản lý bán điện thoại di động.</p>
                    <p class="small mb-0">Bài tập lớn môn Lập trình Web.</p>
                </div>

                <div class="col-md-4">
                    <h2 class="h6 text-white">Danh mục</h2>
                    <ul class="list-unstyled small mb-0">
                        <li><a class="text-white text-decoration-none"
                               asp-controller="Product" asp-action="Index"
                               asp-route-danhMuc="dien-thoai">Điện thoại</a></li>
                        <li><a class="text-white text-decoration-none"
                               asp-controller="Product" asp-action="Index"
                               asp-route-danhMuc="tablet">Tablet</a></li>
                        <li><a class="text-white text-decoration-none"
                               asp-controller="Product" asp-action="Index"
                               asp-route-danhMuc="laptop">Laptop</a></li>
                        <li><a class="text-white text-decoration-none"
                               asp-controller="Product" asp-action="Index"
                               asp-route-danhMuc="phu-kien">Phụ kiện</a></li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <h2 class="h6 text-white">Liên hệ</h2>
                    <ul class="list-unstyled small mb-0">
                        <li><i class="bi bi-telephone"></i> Hotline: 1900 0000</li>
                        <li><i class="bi bi-envelope"></i> contact@shopbanhang.local</li>
                        <li><i class="bi bi-geo-alt"></i> Hà Nội</li>
                    </ul>
                </div>
            </div>

            <hr class="border-light opacity-25" />
            <div class="small text-center mb-0">&copy; 2026 ShopBanHang</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
