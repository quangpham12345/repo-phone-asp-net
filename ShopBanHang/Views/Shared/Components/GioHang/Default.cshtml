@model int
@* id="cartCount" để script trên trang chi tiết cập nhật badge sau khi thêm vào giỏ bằng AJAX *@
<a asp-area="" asp-controller="Cart" asp-action="Index" class="btn mc-btn-outline btn-sm position-relative"
   title="Giỏ hàng">
    <i class="bi bi-cart3"></i> <span class="d-none d-md-inline">Giỏ hàng</span>
    <span id="cartCount"
          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger @(Model > 0 ? "" : "d-none")">
        @Model
    </span>
</a>
