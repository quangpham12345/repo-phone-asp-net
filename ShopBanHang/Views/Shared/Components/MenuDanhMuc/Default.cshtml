@model IEnumerable<Category>
<nav class="hh-nav">
    <div class="container">
        <ul class="nav flex-nowrap overflow-auto">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Product" asp-action="Index">
                    <i class="bi bi-grid me-1"></i> Tất cả
                </a>
            </li>
            @foreach (var dm in Model)
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="Index" asp-route-danhMuc="@dm.Slug">
                        @dm.Name
                    </a>
                </li>
            }
        </ul>
    </div>
</nav>