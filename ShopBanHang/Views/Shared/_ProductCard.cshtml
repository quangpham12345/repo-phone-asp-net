@model Product
@using ShopBanHang.Helpers
@{
    bool coGia = Model.HasVariants;
    int phanTramGiam = TienViet.PhanTramGiam(Model.DisplayPrice, Model.DisplayOldPrice);
    bool hetHang = Model.TotalStock <= 0;

    // Chỉ hiện ô tick so sánh trên trang danh sách /Product (Index)
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool showCompare = string.Equals(controller, "Product", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
}

<div class="product-card">
    <div class="card-img-wrap">
        <div class="hh-badges">
            @if (phanTramGiam > 0)
            {
                <span class="hh-badge hh-badge-sale">-@phanTramGiam%</span>
            }
            @if (Model.IsFeatured)
            {
                <span class="hh-badge hh-badge-hot">HOT</span>
            }
        </div>

        @if (showCompare)
        {
            <div class="compare-check-wrap">
                <input class="form-check-input compare-check"
                       type="checkbox"
                       value="@Model.Id"
                       id="ss-@Model.Id"
                       title="@L["Chọn để so sánh"]"
                       aria-label="@L["Chọn để so sánh"]" />
            </div>
        }

        <a asp-controller="Product" asp-action="Detail" asp-route-slug="@Model.Slug">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/products/no-image.svg" : Model.ImageUrl)"
                 alt="@Model.Name" loading="lazy" />
        </a>
    </div>

    <div class="card-body">
        <h3 class="card-title">
            <a asp-controller="Product" asp-action="Detail" asp-route-slug="@Model.Slug">
                @Model.Name
            </a>
        </h3>

        <div class="price-block">
            @if (!coGia)
            {
                <span class="text-muted small">@L["Đang cập nhật giá"]</span>
            }
            else
            {
                @if (Model.HasPriceRange)
                {
                    <span class="price-from">@L["Từ"] </span>
                }
                <span class="price-current">@TienViet.Dinh(Model.DisplayPrice)</span>
                @if (phanTramGiam > 0)
                {
                    <span class="price-old">@TienViet.Dinh(Model.DisplayOldPrice)</span>
                }
            }
        </div>

        <div class="meta-info">
            @Model.Brand?.Name · @L["Đã bán"] @Model.SoldCount
        </div>

        <div class="mt-auto">
            @if (hetHang)
            {
                <button class="btn btn-out w-100" disabled>@L["Hết hàng"]</button>
            }
            else
            {
                <a class="btn btn-buy"
                   asp-controller="Product" asp-action="Detail" asp-route-slug="@Model.Slug">
                    @L["Xem chi tiết"]
                </a>
            }
        </div>
    </div>
</div>
