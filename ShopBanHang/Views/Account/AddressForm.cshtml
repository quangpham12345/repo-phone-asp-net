@model Address

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h5 mb-3">@(Model.Id == 0 ? "Thêm địa chỉ" : "Sửa địa chỉ")</h1>

                <form asp-action="AddressSave" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="ReceiverName" class="form-label"></label>
                        <input asp-for="ReceiverName" class="form-control" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="ReceiverName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" placeholder="0900000000" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Detail" class="form-label"></label>
                        <textarea asp-for="Detail" class="form-control" rows="2"
                                  placeholder="Số nhà, đường, phường, quận, tỉnh"></textarea>
                        <span asp-validation-for="Detail" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="IsDefault" class="form-check-input" />
                        <label asp-for="IsDefault" class="form-check-label"></label>
                        <div class="form-text">Địa chỉ đầu tiên luôn là mặc định.</div>
                    </div>

                    <button type="submit" class="btn btn-mc-cta w-100">
                        <i class="bi bi-save"></i> Lưu địa chỉ
                    </button>
                    <a asp-action="Addresses" class="btn btn-light w-100 mt-2">Huỷ</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
