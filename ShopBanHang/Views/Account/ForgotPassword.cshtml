@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h5 mb-3">Quên mật khẩu</h1>

                @if (string.IsNullOrEmpty(Model.LienKetDatLai))
                {
                    <p class="small text-muted">
                        Nhập email đã đăng ký, hệ thống sẽ gửi liên kết đặt lại mật khẩu.
                    </p>

                    <form asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="khach1@shop.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-mc-cta w-100">
                            <i class="bi bi-envelope"></i> Gửi liên kết đặt lại
                        </button>
                        <a asp-action="Login" class="btn btn-light w-100 mt-2">Quay lại đăng nhập</a>
                    </form>
                }
                else
                {
                    @* Hệ thống thật gửi liên kết qua email. Bài tập lớn chưa cấu hình
                       máy chủ thư nên hiện thẳng ra đây để còn bấm thử được. *@
                    <div class="alert alert-success py-2 small">
                        <i class="bi bi-check-circle"></i>
                        Đã tạo liên kết đặt lại mật khẩu cho <b>@Model.Email</b>.
                    </div>

                    <p class="small text-muted mb-2">
                        Hệ thống thật sẽ gửi liên kết này qua email. Bài tập lớn chưa cấu hình
                        máy chủ thư nên hiện trực tiếp ở đây:
                    </p>

                    <a href="@Model.LienKetDatLai" class="btn btn-mc-cta w-100">
                        <i class="bi bi-key"></i> Đặt lại mật khẩu ngay
                    </a>

                    <div class="form-text mt-2">
                        Liên kết chỉ dùng được một lần và sẽ hết hạn sau một thời gian.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
