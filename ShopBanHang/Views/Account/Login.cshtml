@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Đăng nhập</h1>

                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />

                    @* Lỗi chung (sai email/mật khẩu) hiện ở đây, lỗi từng ô hiện dưới ô đó *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="admin@shop.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-mc-cta w-100">
                        <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                    </button>
                </form>

                <hr class="my-4" />
                <p class="mb-1 small">
                    Chưa có tài khoản?
                    <a asp-action="Register">Đăng ký ngay</a>
                </p>
                <p class="mb-0 small">
                    <a asp-action="ForgotPassword">Quên mật khẩu?</a>
                </p>
            </div>
        </div>

        @* Tài khoản mẫu do DbInitializer seed, tiện cho việc chấm và thử nghiệm *@
        <div class="alert alert-light border mt-3 small mb-0">
            <b>Tài khoản thử:</b><br />
            Quản trị — <code>admin@shop.com</code> / <code>Admin@123</code><br />
            Khách hàng — <code>khach1@shop.com</code> / <code>Khach@123</code>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
