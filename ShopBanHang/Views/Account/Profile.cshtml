@model ProfileViewModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h5 mb-3">Thông tin tài khoản</h1>

                <form asp-action="Profile" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        @* Email là định danh đăng nhập nên không cho tự đổi ở đây *@
                        <input asp-for="Email" class="form-control" disabled />
                        <div class="form-text">Email đăng nhập không thay đổi được.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-mc-cta">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h6">Tài khoản</h2>
                <dl class="small mb-3">
                    <dt>Vai trò</dt>
                    <dd>@Model.RoleName</dd>
                    <dt>Ngày tạo</dt>
                    <dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
                <a asp-action="Addresses" class="btn btn-outline-secondary btn-sm w-100 mb-2">
                    <i class="bi bi-geo-alt"></i> Sổ địa chỉ giao hàng
                </a>
                <a asp-action="ChangePassword" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-key"></i> Đổi mật khẩu
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
